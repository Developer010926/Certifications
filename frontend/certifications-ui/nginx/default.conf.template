server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name localhost;

    ssl_certificate /run/secrets/frontend_tls_certificate;
    ssl_certificate_key /run/secrets/frontend_tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    error_page 497 = @redirect_to_https;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-API-Key "${SECURITY_API_KEY}";
    }

    location @redirect_to_https {
        return 308 ${FRONTEND_ORIGIN}$request_uri;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
